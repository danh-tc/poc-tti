# Environment ID + Flow ID from the flow URL:
# https://make.powerautomate.com/environments/{ENV_ID}/flows/{FLOW_ID}/details
ENV_ID=
FLOW_ID=
# Optional: your tenant ID or domain (defaults to "organizations")
TENANT_ID=

# Azure Function key for compare-fn (filled into {{COMPARE_FN_KEY}} on push)
COMPARE_FN_KEY=
